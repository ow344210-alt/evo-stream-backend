# ------------------------------------------------------------------
# EVO Platform - Backend Environment Configuration
# Copy to `.env` and fill in real values. NEVER commit `.env`.
# ------------------------------------------------------------------

# Server
PORT=4000
FRONTEND_URL=http://localhost:3000
# Comma-separated extra allowed CORS origins (beyond FRONTEND_URL).
# In development the well-known local origins (localhost/127.0.0.1 on
# :3000 and :8081 for Expo Web) are allowed automatically. Production only
# allows FRONTEND_URL + CORS_ORIGINS — never an unrestricted "*".
# EXAMPLE: CORS_ORIGINS=https://app.example.com,https://studio.example.com
CORS_ORIGINS=

# PostgreSQL (Supabase or self-hosted)
# DATABASE_URL points to the pooled/transaction connection.
# DIRECT_URL points to the direct/session connection (used for migrations).
DATABASE_URL=
DIRECT_URL=

# JWT Authentication
# Generate long random secrets, e.g.:
#   openssl rand -base64 48
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# Email (Resend)
# Leave RESEND_API_KEY empty to keep the EmailService in development mode.
RESEND_API_KEY=
EMAIL_FROM=EVO <no-reply@yourdomain.com>

# Runtime environment. When set to "production" the backend NEVER logs email
# verification codes to the terminal. In any other value (development/test),
# generated verification codes are logged to the backend terminal as
# "[DEV EMAIL VERIFICATION]" so local flows (register -> verify -> login) can be
# tested without a verified Resend domain. Codes are never returned in API
# responses and never exposed to the frontend.
NODE_ENV=development

# ------------------------------------------------------------------
# Video storage foundation (Phase 2 P2-2)
# ------------------------------------------------------------------
# The video provider is selected purely through configuration so client /
# production credentials can be swapped in later without rewriting application
# or business logic. Only the variables genuinely required by the current
# implementation are defined here; provider credentials are intentionally NOT
# read or stored by the application at this stage.
#
# Provider: "local" (development/tests) | "s3" | "bunny".
# Selecting "s3" or "bunny" now fails fast at startup until the production
# adapter is implemented in a later Phase 2 step. This prevents production from
# silently falling back to local development storage.
VIDEO_STORAGE_PROVIDER=local

# Absolute or relative-on-cwd filesystem root used only by the "local" provider.
# Uploaded/test binaries under this directory are git-ignored. Never point this
# at src/ or any other source-controlled directory.
# Optional: when omitted, defaults to "<backend>/storage".
VIDEO_LOCAL_STORAGE_PATH=

# Maximum accepted size of a single video source upload, in bytes.
# Optional: when omitted, defaults to 10 GB (10 * 1024^3).
VIDEO_MAX_UPLOAD_BYTES=10737418240

# Comma-separated list of accepted video media types for future upload
# validation. Optional: when omitted, the platform defaults are used.
# EXAMPLE: VIDEO_ACCEPTED_MIME_TYPES=video/mp4,video/quicktime,video/webm
VIDEO_ACCEPTED_MIME_TYPES=

# ------------------------------------------------------------------
# Video processing / HLS transcoding (Phase 2 P2-4)
# ------------------------------------------------------------------
# FFmpeg & Ffprobe binaries. By default resolved from PATH. Set to absolute paths
# if installed elsewhere.
# FFMPEG_PATH=ffmpeg
# FFPROBE_PATH=ffprobe

# Same length adaptive bitrate ladder, rendered as HLS VOD renditions.
# Format: label:videoKbps:audioKbps (comma-separated). Defaults to the platform
# 360p/480p/720p/1080p ladder when omitted.
# EXAMPLE: VIDEO_TRANSCODE_LADDER=360p:450:96,480p:800:128,720p:1500:128,1080p:2800:192
# VIDEO_TRANSCODE_LADDER=

# Seconds offset into the source used to extract the poster thumbnail.
# Optional: defaults to 5.
# VIDEO_POSTER_AT_SEC=5

# When "true", require FFmpeg/Ffprobe to resolve at startup (fail fast).
# Default "false": the app boots without FFmpeg and any processing job is marked
# FAILED with a clear message instead of crashing the process.
# VIDEO_TRANSCODE_REQUIRE_BIN=false

# ------------------------------------------------------------------
# Future production provider configuration (NOT used yet by P2-2).
# Documented here as the intended boundary so credentials can be added later
# without code changes. Do not commit real secrets.
# ------------------------------------------------------------------
# VIDEO_STORAGE_ENDPOINT=
# VIDEO_STORAGE_BUCKET=
# VIDEO_STORAGE_ACCESS_KEY=
# VIDEO_STORAGE_SECRET_KEY=
# BUNNY_STORAGE_ZONE_NAME=
# BUNNY_STORAGE_ACCESS_KEY=
